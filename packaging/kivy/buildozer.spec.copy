[app]
title = Pipeline EDS
package.name = pipeline_eds
package.domain = org.memphistn.gov

# Point to your package code and main entry file (main.py)
source.dir = ./src/frontend_kivy

# Ensure relevant file extensions are included
source.include_exts = py,png,jpg,kv,atlas

# Dependencies required for build
requirements = python3,kivy

# Permissions required (e.g., internet access for REST/SOAP APIs)
android.permissions = INTERNET
